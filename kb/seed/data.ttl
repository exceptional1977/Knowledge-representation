# ---------- нормативы (параметры бизнес-правил) ----------
ex:Norm_SLA_Loan a ex:Norm ; rdfs:label "Норматив SLA кредитной заявки"@ru ; ex:semNode sn:SLANorm ;
    ex:thresholdHours 720.0 ; ex:warnShare 0.8 .
ex:Norm_Quality a ex:Norm ; rdfs:label "Требования к качеству журнала"@ru ; ex:semNode sn:DataQualityReq ;
    ex:maxMissingRatio 0.05 ; ex:maxDuplicateRatio 0.01 ; ex:minPrefixLength 3 .
ex:Norm_ModelSelection a ex:Norm ; rdfs:label "Политика выбора модели"@ru ; ex:semNode sn:ModelSelectionPolicy ;
    ex:maxRelDiff 0.25 ; ex:complexityThreshold 3 .
ex:Norm_Escalation a ex:Norm ; rdfs:label "Регламент эскалации"@ru ; ex:semNode sn:EscalationRegulation ;
    ex:minConfidence 0.7 .
ex:Norm_Drift a ex:Norm ; rdfs:label "Порог дрейфа и загрузки GPU"@ru ; ex:semNode sn:DriftThreshold ;
    ex:driftThreshold 0.2 ; ex:maxGpuLoad 0.8 .

