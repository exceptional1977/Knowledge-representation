    rdfs:label "Достаточность данных"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:ProcessCase ;
    rdfs:range ex:Status .

ex:decision a owl:FunctionalProperty,
