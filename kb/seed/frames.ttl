    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "механизм вывода" ;
    rdfs:domain ex:InformationObject ;
    rdfs:range ex:Rule .

ex:bottleneckActivity a owl:DatatypeProperty ;
