    ex:inheritance "U" ;
    ex:valueSource "из базы данных (анализ ожиданий)" ;
    rdfs:domain ex:ProcessCase ;
    rdfs:range xsd:string .

ex:bottleneckCandidate a owl:DatatypeProperty ;
    rdfs:label "Кандидат в узкие места"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
