@prefix ex: <http://bmstu.ru/iu12/ocpa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sn: <http://bmstu.ru/iu12/ocpa/sn#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:BusinessAnalystRole a owl:Class ;
    rdfs:label "Бизнес-аналитик"@ru ;
    ex:frameKind "прототип-роль" ;
    ex:semNode sn:BusinessAnalyst ;
    ex:slotDefault [ ex:slot ex:responsibility ;
            ex:value "мониторинг SLA и поиск узких мест" ] ;
    rdfs:subClassOf ex:Role .

ex:CleanDuplicates a ex:Status ;
    rdfs:label "очистить дубликаты"@ru .

ex:DataDriftSituation a owl:Class ;
    rdfs:label "Дрейф данных модели"@ru ;
    ex:frameKind "ситуация" ;
    ex:semNode sn:DataDrift ;
    ex:slotDefault [ ex:slot ex:description ;
            ex:value "индекс стабильности признаков выше порога" ] ;
    rdfs:subClassOf ex:Situation .

ex:DataEngineerRole a owl:Class ;
    rdfs:label "Инженер данных"@ru ;
    ex:frameKind "прототип-роль" ;
    ex:semNode sn:DataEngineer ;
    ex:slotDefault [ ex:slot ex:responsibility ;
            ex:value "выгрузка и качество журналов" ] ;
    rdfs:subClassOf ex:Role .

ex:DomainExpertRole a owl:Class ;
    rdfs:label "Эксперт предметной области"@ru ;
    ex:frameKind "прототип-роль" ;
    ex:semNode sn:DomainExpert ;
    ex:slotDefault [ ex:slot ex:responsibility ;
            ex:value "проверка интерпретации прогнозов" ] ;
    rdfs:subClassOf ex:Role .

ex:EnhancedControl a ex:Status ;
    rdfs:label "усиленный контроль"@ru .

ex:EscalateToOwner a ex:Status ;
    rdfs:label "эскалировать владельцу процесса"@ru .

ex:ExternalSystem a owl:Class ;
    rdfs:label "Внешняя система"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:ERPSystem ;
    rdfs:subClassOf ex:Entity .

ex:Facility a owl:Class ;
    rdfs:label "Помещение"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:DataCenter ;
    rdfs:subClassOf ex:Entity .

ex:HighComplexity a ex:Status ;
    rdfs:label "высокая"@ru .

ex:HighRisk a ex:Status ;
    rdfs:label "высокий"@ru .

ex:Inactive a ex:ModelStatus ;
    rdfs:label "выведена из эксплуатации"@ru .

ex:Insufficient a ex:Status ;
    rdfs:label "данных недостаточно"@ru .

ex:InsufficientData a owl:Class ;
    rdfs:label "Недостаточно данных для прогноза"@ru ;
    ex:frameKind "ситуация" ;
    ex:semNode sn:DataQualityReq ;
    ex:slotDefault [ ex:slot ex:typical ;
            ex:value false ],
        [ ex:slot ex:description ;
            ex:value "нетипичная: префикс короче минимального, прогноз невозможен" ] ;
    rdfs:subClassOf ex:Situation .

ex:LoanApplicationCase a owl:Class ;
    rdfs:label "Кейс кредитной заявки"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:Application ;
    ex:slotDefault [ ex:slot ex:slaNorm ;
            ex:value ex:Norm_SLA_Loan ] ;
    rdfs:subClassOf ex:ProcessCase .

ex:LowQuality a ex:Status ;
    rdfs:label "низкое качество"@ru .

ex:LowRisk a ex:Status ;
    rdfs:label "низкий"@ru .

ex:MLEngineerRole a owl:Class ;
    rdfs:label "ML-инженер"@ru ;
    ex:frameKind "прототип-роль" ;
    ex:semNode sn:MLEngineer ;
    ex:slotDefault [ ex:slot ex:responsibility ;
            ex:value "качество и переобучение моделей" ] ;
    rdfs:subClassOf ex:Role .

ex:MediumRisk a ex:Status ;
    rdfs:label "умеренный"@ru .

ex:NormalComplexity a ex:Status ;
    rdfs:label "обычная"@ru .

ex:OCELLog a owl:Class ;
    rdfs:label "OCEL-журнал"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:OCELLog ;
    ex:slotDefault [ ex:slot ex:format ;
            ex:value "OCEL 2.0" ] ;
    rdfs:subClassOf ex:EventLog .

ex:ObuchayuschayaVyborka a owl:Class ;
    rdfs:label "Обучающая выборка"@ru ;
    ex:createdAt "2026-11-19T16:39:02"^^xsd:dateTime ;
    ex:frameKind "прототип-объект" ;
    ex:modifiedAt "2026-11-19T16:39:02"^^xsd:dateTime ;
    ex:modifiedBy "И.С. Бронников" ;
    ex:semNode sn:ObuchayuschayaVyborka ;
    rdfs:subClassOf ex:InformationObject .

ex:PostponeRetraining a ex:Status ;
    rdfs:label "отложить переобучение"@ru .

ex:ProcessOwnerRole a owl:Class ;
    rdfs:label "Владелец процесса"@ru ;
    ex:frameKind "прототип-роль" ;
    ex:semNode sn:ProcessOwner ;
    ex:slotDefault [ ex:slot ex:responsibility ;
            ex:value "KPI процесса и решения по эскалациям" ],
        [ ex:slot ex:notifyChannel ;
            ex:value "электронная почта и мессенджер" ] ;
    rdfs:subClassOf ex:Role .

ex:Recommendation a owl:Class ;
    rdfs:label "Рекомендация"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:Recommendation ;
    rdfs:subClassOf ex:InformationObject .

ex:RegularMonitoring a ex:Status ;
    rdfs:label "штатный мониторинг"@ru .

ex:RequestExpertReview a ex:Status ;
    rdfs:label "запросить заключение эксперта"@ru .

ex:RequestMoreData a ex:Status ;
    rdfs:label "дождаться событий / запросить данные"@ru .

ex:RetrainNow a ex:Status ;
    rdfs:label "переобучить модель"@ru .

ex:SLARiskHigh a owl:Class ;
    rdfs:label "Высокий риск нарушения SLA"@ru ;
    ex:frameKind "ситуация" ;
    ex:semNode sn:SLAEscalation ;
    ex:slotDefault [ ex:slot ex:description ;
            ex:value "прогнозное время цикла больше норматива SLA" ] ;
    rdfs:subClassOf ex:Situation .

ex:SLARiskMedium a owl:Class ;
    rdfs:label "Умеренный риск нарушения SLA"@ru ;
    ex:frameKind "ситуация" ;
    ex:semNode sn:SLAMonitoring ;
    ex:slotDefault [ ex:slot ex:description ;
            ex:value "прогноз между порогом внимания и нормативом" ] ;
    rdfs:subClassOf ex:Situation .

ex:Scenario a owl:Class ;
    rdfs:label "Сценарий"@ru ;
    ex:frameKind "сценарий" ;
    ex:semNode sn:PredictiveMonitoring ;
    rdfs:subClassOf ex:Entity .

ex:ScenarioRun a owl:Class ;
    rdfs:label "Экземпляр исполнения сценария"@ru ;
    ex:frameKind "экземпляр сценария" ;
    ex:semNode sn:SLAMonitoring ;
    rdfs:subClassOf ex:Entity .

ex:Scene a owl:Class ;
    rdfs:label "Сцена"@ru ;
    ex:frameKind "ситуация" ;
    ex:semNode sn:SLAMonitoring ;
    rdfs:subClassOf ex:Situation .

ex:StorageNode a owl:Class ;
    rdfs:label "Сетевое хранилище"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:NetworkStorage ;
    rdfs:subClassOf ex:ComputeNode .

ex:Sufficient a ex:Status ;
    rdfs:label "данных достаточно"@ru .

ex:UnknownRisk a ex:Status ;
    rdfs:label "не определён"@ru .

ex:XESLog a owl:Class ;
    rdfs:label "XES-журнал"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:XESLog ;
    ex:slotDefault [ ex:slot ex:format ;
            ex:value "XES (IEEE 1849-2016)" ] ;
    rdfs:subClassOf ex:EventLog .

ex:XGBoostModel a owl:Class ;
    rdfs:label "Модель XGBoost"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:XGBModel ;
    ex:slotDefault [ ex:slot ex:deployedOn ;
            ex:value ex:AppServer01 ] ;
    rdfs:subClassOf ex:PredictiveModel .

ex:action a owl:DatatypeProperty ;
    rdfs:label "Что сделать"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:InformationObject ;
    rdfs:range xsd:string .

ex:addressee a owl:ObjectProperty ;
    rdfs:label "Адресат"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:InformationObject ;
    rdfs:range ex:Role .

ex:applicableModel a owl:ObjectProperty ;
    rdfs:label "Применимая модель"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:ProcessCase ;
    rdfs:range ex:PredictiveModel .

ex:askable a owl:AnnotationProperty ;
    rdfs:label "Значение можно запросить у пользователя"@ru .

ex:avgWaitHours a owl:DatatypeProperty ;
    rdfs:label "Среднее ожидание между событиями, ч"@ru ;
