    rdfs:range xsd:string .

ex:byModel a owl:ObjectProperty ;
    rdfs:label "Модель"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "присоединённая процедура «predict_forecast»" ;
    rdfs:domain ex:Forecast ;
