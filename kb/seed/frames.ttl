    ex:valueSource "из диалога с пользователем" ;
    rdfs:domain ex:Role ;
    rdfs:range xsd:string .

ex:predictedHours a owl:DatatypeProperty ;
    rdfs:label "Прогноз остатка, ч"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:onAdded "run_inference" ;
    ex:valueSource "присоединённая процедура «predict_forecast»" ;
    rdfs:domain ex:Forecast ;
    rdfs:range xsd:decimal .

ex:prefixLength a owl:DatatypeProperty ;
    rdfs:label "Длина префикса, событий"@ru ;
    ex:askable true ;
    ex:inheritance "U" ;
    ex:onAdded "update_case_dependents" ;
    ex:valueSource "из базы данных (поток событий)" ;
    rdfs:domain ex:ProcessCase ;
    rdfs:range xsd:integer .

ex:qualityStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Качество журнала"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:EventLog ;
    rdfs:range ex:Status .

ex:relDiff a owl:DatatypeProperty ;
    rdfs:label "Относительное расхождение"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:ModelConflict ;
    rdfs:range xsd:decimal .

ex:retrainingRequired a owl:DatatypeProperty ;
    rdfs:label "Требуется переобучение"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:PredictiveModel ;
    rdfs:range xsd:boolean .

ex:riskLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Риск нарушения SLA"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:ProcessCase ;
    rdfs:range ex:Status .

ex:rmse a owl:DatatypeProperty ;
    rdfs:label "RMSE, ч"@ru ;
    ex:inheritance "R" ;
    ex:valueSource "из базы данных (результаты обучения)" ;
    rdfs:domain ex:PredictiveModel ;
    rdfs:range xsd:decimal .

ex:selectedForecastHours a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Принятый прогноз остатка, ч"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:ProcessCase ;
    rdfs:range xsd:decimal .

ex:selectedModel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Выбранная модель"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:ProcessCase ;
    rdfs:range ex:PredictiveModel .

ex:semNode a owl:AnnotationProperty ;
    rdfs:label "Вершина семантической сети"@ru .

ex:situationOf a owl:ObjectProperty ;
    rdfs:label "Ситуация относится к"@ru ;
    ex:derived true ;
    ex:inheritance "U" ;
    ex:valueSource "продукционное правило" ;
    rdfs:domain ex:Situation ;
    rdfs:range ex:Entity .

ex:slot a owl:AnnotationProperty .

ex:slotDefault a owl:AnnotationProperty ;
    rdfs:label "Значение слота по умолчанию"@ru .

ex:thresholdHours a owl:DatatypeProperty ;
    rdfs:label "Норматив, ч"@ru ;
    ex:inheritance "R" ;
    ex:onAdded "run_inference" ;
    ex:valueSource "из регламента" ;
    rdfs:domain ex:Norm ;
    rdfs:range xsd:decimal .

ex:trainedOn a owl:ObjectProperty ;
    rdfs:label "Обучена на журнале"@ru ;
    ex:inheritance "U" ;
    ex:onRemoved "find_dangling_refs" ;
    ex:valueSource "из базы данных" ;
    rdfs:domain ex:PredictiveModel ;
    rdfs:range ex:EventLog .

ex:value a owl:AnnotationProperty .

ex:valueSource a owl:AnnotationProperty ;
    rdfs:label "Способ получения значения"@ru .

ex:version a owl:DatatypeProperty ;
    rdfs:label "Версия"@ru ;
    ex:inheritance "U" ;
    ex:valueSource "из базы данных" ;
    rdfs:domain ex:Entity ;
    rdfs:range xsd:string .

ex:warnShare a owl:DatatypeProperty ;
    rdfs:label "Порог внимания (доля норматива)"@ru ;
    ex:inheritance "R" ;
    ex:onAdded "run_inference" ;
    ex:valueSource "из регламента" ;
    rdfs:domain ex:Norm ;
    rdfs:range xsd:decimal .

ex:Active a ex:ModelStatus ;
    rdfs:label "в эксплуатации"@ru .

ex:GNNModel a owl:Class ;
    rdfs:label "Графовая нейросеть"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:GNNModel ;
    ex:slotDefault [ ex:slot ex:inputRepresentation ;
            ex:value "граф «событие–объект»" ],
        [ ex:slot ex:biasFactor ;
            ex:value 0.95 ],
        [ ex:slot ex:objectSensitivity ;
            ex:value 0.15 ],
        [ ex:slot ex:deployedOn ;
            ex:value ex:GPU01 ] ;
    rdfs:subClassOf ex:PredictiveModel .

ex:GPUServer a owl:Class ;
    rdfs:label "GPU-сервер"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:GPUServer ;
    ex:slotDefault [ ex:slot ex:gpuCount ;
            ex:value 2 ] ;
    rdfs:subClassOf ex:Server .

ex:HeteroGNNModel a owl:Class ;
    rdfs:label "Гетерогенная GNN"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:HeteroGNN ;
    ex:slotDefault [ ex:slot ex:nodeTypes ;
            ex:value "событие, заявка, предложение, ресурс" ] ;
    rdfs:subClassOf ex:GNNModel .

ex:ModelConflict a owl:Class ;
    rdfs:label "Расхождение прогнозов моделей"@ru ;
    ex:frameKind "ситуация" ;
    ex:semNode sn:ModelSelectionPolicy ;
    ex:slotDefault [ ex:slot ex:description ;
            ex:value "прогнозы XGBoost и GNN различаются больше допустимого" ] ;
    rdfs:subClassOf ex:Situation .

ex:Notification a owl:Class ;
    rdfs:label "Уведомление"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:Recommendation ;
    rdfs:subClassOf ex:InformationObject .

ex:Rule a owl:Class ;
    rdfs:label "Продукционное правило"@ru ;
    ex:frameKind "правило" ;
    ex:semNode sn:DSSModule ;
    rdfs:subClassOf ex:Entity .

ex:Server a owl:Class ;
    rdfs:label "Сервер"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:Server ;
    ex:slotDefault [ ex:slot ex:location ;
            ex:value "Серверная ЦОД-1" ] ;
    rdfs:subClassOf ex:ComputeNode .

ex:SystemModule a owl:Class ;
    rdfs:label "Модуль системы"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:OCPAModule ;
    rdfs:subClassOf ex:Entity .

ex:gpuCount a owl:DatatypeProperty ;
    rdfs:label "Число GPU"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:GPUServer ;
    rdfs:range xsd:integer .

ex:load a owl:DatatypeProperty ;
    rdfs:label "Загрузка (доля)"@ru ;
    ex:inheritance "U" ;
    ex:onAdded "run_inference" ;
    ex:valueSource "из системы мониторинга" ;
    rdfs:domain ex:ComputeNode ;
    rdfs:range xsd:decimal .

ex:location a owl:DatatypeProperty ;
    rdfs:label "Расположение"@ru ;
    ex:inheritance "S" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:ComputeNode ;
    rdfs:range xsd:string .

ex:medianTraceLength a owl:DatatypeProperty ;
    rdfs:label "Медианная длина трассы"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO / из базы" ;
    rdfs:domain ex:EventLog ;
    rdfs:range xsd:integer .

ex:nodeTypes a owl:DatatypeProperty ;
    rdfs:label "Типы вершин графа"@ru ;
    ex:inheritance "S" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:HeteroGNNModel ;
    rdfs:range xsd:string .

ex:slaNorm a owl:ObjectProperty ;
    rdfs:label "Норматив SLA"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:ProcessCase ;
    rdfs:range ex:Norm .

ex:status a owl:ObjectProperty ;
    rdfs:label "Статус"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:PredictiveModel ;
    rdfs:range ex:ModelStatus .

ex:storedIn a owl:ObjectProperty ;
    rdfs:label "Хранится на"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:InformationObject ;
    rdfs:range ex:ComputeNode .

ex:Forecast a owl:Class ;
    rdfs:label "Прогноз KPI"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:Forecast ;
    rdfs:subClassOf ex:InformationObject .

ex:biasFactor a owl:DatatypeProperty ;
    rdfs:label "Масштабный коэффициент"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:PredictiveModel ;
    rdfs:range xsd:decimal .

ex:deployedOn a owl:ObjectProperty ;
    rdfs:label "Развёрнута на"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:PredictiveModel ;
    rdfs:range ex:ComputeNode .

ex:format a owl:DatatypeProperty ;
    rdfs:label "Формат"@ru ;
    ex:inheritance "S" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:EventLog ;
    rdfs:range xsd:string .

ex:inputRepresentation a owl:DatatypeProperty ;
    rdfs:label "Представление входа"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:PredictiveModel ;
    rdfs:range xsd:string .

ex:notifyChannel a owl:DatatypeProperty ;
    rdfs:label "Канал уведомлений"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:Role ;
    rdfs:range xsd:string .

ex:objectSensitivity a owl:DatatypeProperty ;
    rdfs:label "Чувствительность к объектам"@ru ;
    ex:inheritance "O" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:PredictiveModel ;
    rdfs:range xsd:decimal .

ex:typical a owl:DatatypeProperty ;
    rdfs:label "Типовая ситуация"@ru ;
    ex:inheritance "S" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:Situation ;
    rdfs:range xsd:boolean .

ex:ModelStatus a owl:Class ;
    rdfs:label "Статус модели"@ru .

ex:description a owl:DatatypeProperty ;
    rdfs:label "Описание"@ru ;
    ex:inheritance "S" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:Situation ;
    rdfs:range xsd:string .

ex:responsibility a owl:DatatypeProperty ;
    rdfs:label "Зона ответственности"@ru ;
    ex:inheritance "S" ;
    ex:valueSource "наследование через AKO" ;
    rdfs:domain ex:Role ;
    rdfs:range xsd:string .

ex:ComputeNode a owl:Class ;
    rdfs:label "Вычислительный узел"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:ComputeNode ;
    ex:slotDefault [ ex:slot ex:load ;
            ex:value 0.0 ] ;
    rdfs:subClassOf ex:Entity .

ex:Role a owl:Class ;
    rdfs:label "Роль"@ru ;
    ex:frameKind "прототип-роль" ;
    ex:semNode sn:Participant ;
    ex:slotDefault [ ex:slot ex:notifyChannel ;
            ex:value "электронная почта" ] ;
    rdfs:subClassOf ex:Entity .

ex:Situation a owl:Class ;
    rdfs:label "Ситуация"@ru ;
    ex:frameKind "ситуация" ;
    ex:semNode sn:SLAMonitoring ;
    ex:slotDefault [ ex:slot ex:typical ;
            ex:value true ] ;
    rdfs:subClassOf ex:Entity .

ex:Norm a owl:Class ;
    rdfs:label "Норматив"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:MonitoringRegulation ;
    rdfs:subClassOf ex:Entity .

ex:EventLog a owl:Class ;
    rdfs:label "Журнал событий"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:EventLog ;
    ex:slotDefault [ ex:slot ex:medianTraceLength ;
            ex:value 20 ] ;
    rdfs:subClassOf ex:InformationObject .

ex:InformationObject a owl:Class ;
    rdfs:label "Информационный объект"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:InformationObject ;
    ex:slotDefault [ ex:slot ex:storedIn ;
            ex:value ex:DBServer01 ] ;
    rdfs:subClassOf ex:Entity .

ex:PredictiveModel a owl:Class ;
    rdfs:label "Прогнозная модель"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:PredictiveModel ;
    ex:slotDefault [ ex:slot ex:inputRepresentation ;
            ex:value "вектор признаков префикса" ],
        [ ex:slot ex:biasFactor ;
            ex:value 1.0 ],
        [ ex:slot ex:objectSensitivity ;
            ex:value 0.0 ],
        [ ex:slot ex:status ;
            ex:value ex:Active ] ;
    rdfs:subClassOf ex:InformationObject .

ex:Entity a owl:Class ;
    rdfs:label "Сущность"@ru ;
    ex:frameKind "прототип-объект" ;
    rdfs:comment "Корневой фрейм: несёт служебные слоты (дата создания, автор изменения)" .

ex:ProcessCase a owl:Class ;
    rdfs:label "Экземпляр процесса"@ru ;
    ex:frameKind "прототип-объект" ;
    ex:semNode sn:ProcessCase ;
    rdfs:subClassOf ex:InformationObject .

ex:Status a owl:Class ;
    rdfs:label "Значение-состояние"@ru .

