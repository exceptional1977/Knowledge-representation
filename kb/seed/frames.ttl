ex:complexityThreshold a owl:DatatypeProperty ;
    rdfs:label "Порог объектной сложности"@ru ;
    ex:inheritance "R" ;
    ex:onAdded "run_inference" ;
    ex:valueSource "из регламента" ;
    rdfs:domain ex:Norm ;
    rdfs:range xsd:integer .

ex:confidence a owl:DatatypeProperty ;
    rdfs:label "Уверенность"@ru ;
    ex:derived true ;
    ex:ifNeeded "estimate_confidence" ;
    ex:inheritance "U" ;
    ex:valueSource "присоединённая процедура «estimate_confidence»" ;
    rdfs:domain ex:InformationObject ;
    rdfs:range xsd:decimal .

ex:createdAt a owl:DatatypeProperty ;
    rdfs:label "Дата создания"@ru ;
    ex:inheritance "U" ;
    ex:valueSource "служебный: при создании" ;
    rdfs:domain ex:Entity ;
    rdfs:range xsd:dateTime .

ex:dataStatus a owl:FunctionalProperty,
