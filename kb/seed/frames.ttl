    rdfs:range xsd:decimal .

ex:frameKind a owl:AnnotationProperty ;
    rdfs:label "Вид фрейма"@ru .

ex:graphDensity a owl:DatatypeProperty ;
    rdfs:label "Плотность графа событие–объект"@ru ;
