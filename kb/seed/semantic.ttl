@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sn: <http://bmstu.ru/iu12/ocpa/sn#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sn:BusinessAnalyst a sn:Concept ;
    rdfs:label "Бизнес-аналитик"@ru ;
    sn:attr [ sn:attrName "Уровень доступа" ;
            sn:attrValue "чтение прогнозов, запуск мониторинга" ] ;
    sn:definition "Формулирует вопросы к процессу, следит за SLA, ищет узкие места и готовит управленческие предложения" ;
    sn:group sn:G_Role ;
    sn:isA sn:Participant ;
    sn:performs sn:BottleneckAnalysis,
        sn:RecommendationMaking,
        sn:SLAMonitoring ;
    sn:responsibleFor sn:GoalBottlenecks ;
    sn:uses sn:AnalystWorkstation,
        sn:WebUI .

sn:DataEngineer a sn:Concept ;
    rdfs:label "Инженер данных"@ru ;
    sn:definition "Выгружает журналы из учётных систем, конвертирует XES в OCEL и отвечает за их качество" ;
    sn:group sn:G_Role ;
    sn:isA sn:DataSpecialist ;
    sn:performs sn:LogCollection,
        sn:XesToOcel .

sn:DomainExpert a sn:Concept ;
    rdfs:label "Эксперт предметной области"@ru ;
    sn:definition "Специалист по кредитному процессу, подтверждающий интерпретацию прогнозов и правил" ;
    sn:group sn:G_Role ;
    sn:isA sn:Participant ;
    sn:performs sn:QualityCheck ;
    sn:responsibleFor sn:GoalInterpretability .

sn:GPU01 a sn:Concept ;
    rdfs:label "GPU-сервер gpu-01"@ru ;
    sn:definition "Конкретный GPU-сервер стойки 3 серверной" ;
    sn:group sn:G_Phys ;
    sn:instanceOf sn:GPUServer ;
    sn:locatedIn sn:DataCenter .

sn:MLEngineer a sn:Concept ;
    rdfs:label "ML-инженер"@ru ;
    sn:attr [ sn:attrName "Уровень доступа" ;
            sn:attrValue "обучение и выкладка моделей" ] ;
    sn:definition "Обучает, сравнивает и переобучает модели прогнозирования KPI (XGBoost, GNN)" ;
    sn:group sn:G_Role ;
    sn:isA sn:DataSpecialist ;
    sn:performs sn:ModelTraining,
        sn:Retraining ;
    sn:responsibleFor sn:ModelQuality .

sn:MonitoringRegulation a sn:Concept ;
    rdfs:label "Регламент мониторинга процесса"@ru ;
    sn:definition "Документ, задающий порядок предиктивного мониторинга кредитных заявок" ;
    sn:group sn:G_Rule ;
    sn:partOf sn:DataQualityReq,
        sn:EscalationRegulation,
        sn:ModelSelectionPolicy,
        sn:PraviloOtsecheniyaPrefiksa,
        sn:SLANorm ;
    sn:regulates sn:PredictiveMonitoring .

sn:OCPAModule a sn:Concept ;
    rdfs:label "Модуль процессной аналитики"@ru ;
    sn:aimsAt sn:GoalBottlenecks ;
    sn:definition "Программный модуль ВКР, автоматизирующий предиктивный мониторинг по OCEL 2.0" ;
    sn:group sn:G_System ;
    sn:partOf sn:Converter,
        sn:DSSModule,
        sn:FeatureModule,
        sn:GNNModule,
        sn:LoadModule,
        sn:MLModule,
        sn:WebUI .

sn:RetrainingRegulation a sn:Concept ;
    rdfs:label "Регламент переобучения"@ru ;
    sn:definition "Условия и порядок переобучения моделей при дрейфе данных" ;
    sn:group sn:G_Rule ;
    sn:partOf sn:DriftThreshold ;
    sn:regulates sn:Retraining .

sn:affects a sn:Relation ;
    rdfs:label "влияет на"@ru ;
    sn:domainGroup sn:G_Info,
        sn:G_Process ;
    sn:inverseLabel "зависит от"@ru ;
    sn:rangeGroup sn:G_Goal ;
    sn:relGroup "Функциональные" ;
    sn:transitive false .

sn:agent a sn:Relation ;
    rdfs:label "агент"@ru ;
    sn:domainGroup sn:G_Process ;
    sn:inverseLabel "является агентом"@ru ;
    sn:rangeGroup sn:G_Role ;
    sn:relGroup "Падежные (N-арные)" ;
    sn:transitive false .

sn:aimsAt a sn:Relation ;
    rdfs:label "служит цели"@ru ;
    sn:domainGroup sn:G_Process,
        sn:G_System ;
    sn:inverseLabel "достигается через"@ru ;
    sn:rangeGroup sn:G_Goal ;
    sn:relGroup "Функциональные" ;
    sn:transitive false .

sn:automates a sn:Relation ;
    rdfs:label "автоматизирует"@ru ;
    sn:domainGroup sn:G_System ;
    sn:inverseLabel "автоматизируется"@ru ;
    sn:rangeGroup sn:G_Process ;
    sn:relGroup "Функциональные" ;
    sn:transitive false .

sn:basis a sn:Relation ;
    rdfs:label "основание"@ru ;
    sn:domainGroup sn:G_Process ;
    sn:inverseLabel "является основанием"@ru ;
    sn:rangeGroup sn:G_Rule ;
    sn:relGroup "Падежные (N-арные)" ;
    sn:transitive false .

sn:causes a sn:Relation ;
    rdfs:label "вызывает"@ru ;
    sn:domainGroup sn:G_Info,
        sn:G_Process ;
    sn:inverseLabel "вызывается"@ru ;
    sn:rangeGroup sn:G_Info,
        sn:G_Process ;
    sn:relGroup "Причинно-следственные" ;
    sn:transitive false .

sn:conditionOf a sn:Relation ;
    rdfs:label "является условием"@ru ;
    sn:domainGroup sn:G_Info,
        sn:G_Rule ;
    sn:inverseLabel "требует условия"@ru ;
    sn:rangeGroup sn:G_Process ;
    sn:relGroup "Причинно-следственные" ;
    sn:transitive false .

sn:creates a sn:Relation ;
    rdfs:label "создаёт"@ru ;
    sn:domainGroup sn:G_Process,
        sn:G_System ;
    sn:inverseLabel "создаётся в"@ru ;
    sn:rangeGroup sn:G_Info ;
    sn:relGroup "Функциональные" ;
    sn:transitive false .

sn:during a sn:Relation ;
    rdfs:label "выполняется во время"@ru ;
    sn:domainGroup sn:G_Process ;
    sn:inverseLabel "включает во время"@ru ;
    sn:rangeGroup sn:G_Process ;
    sn:relGroup "Временные" ;
    sn:transitive false .

sn:hasProperty a sn:Relation ;
    rdfs:label "имеет свойство"@ru ;
    sn:domainGroup sn:G_Info,
        sn:G_Phys,
        sn:G_Process,
        sn:G_System ;
    sn:inverseLabel "является свойством"@ru ;
    sn:rangeGroup sn:G_Goal ;
    sn:relGroup "Атрибутивные" ;
    sn:transitive false .

sn:instanceOf a sn:Relation ;
    rdfs:label "экземпляр класса"@ru ;
    sn:domainGroup sn:AnyGroup ;
    sn:inheritsAttributes true ;
    sn:inverseLabel "имеет экземпляр"@ru ;
    sn:rangeGroup sn:AnyGroup ;
    sn:relGroup "Родовидовые" ;
    sn:sameGroup true ;
    sn:transitive false .

sn:instrument a sn:Relation ;
    rdfs:label "инструмент"@ru ;
    sn:domainGroup sn:G_Process ;
    sn:inverseLabel "является инструментом"@ru ;
    sn:rangeGroup sn:G_System ;
    sn:relGroup "Падежные (N-арные)" ;
    sn:transitive false .

sn:isA a sn:Relation ;
    rdfs:label "является"@ru ;
    sn:domainGroup sn:AnyGroup ;
    sn:inheritsAttributes true ;
    sn:inverseLabel "имеет вид"@ru ;
    sn:rangeGroup sn:AnyGroup ;
    sn:relGroup "Родовидовые" ;
    sn:sameGroup true ;
    sn:transitive true .

sn:locatedIn a sn:Relation ;
    rdfs:label "расположен в"@ru ;
    sn:domainGroup sn:G_Phys,
        sn:G_System ;
    sn:inverseLabel "содержит"@ru ;
    sn:rangeGroup sn:G_Phys ;
    sn:relGroup "Пространственные и количественные" ;
    sn:transitive true .

sn:notGreater a sn:Relation ;
    rdfs:label "не больше"@ru ;
    sn:domainGroup sn:G_Goal ;
    sn:inverseLabel "не меньше"@ru ;
    sn:rangeGroup sn:G_Goal,
        sn:G_Rule ;
    sn:relGroup "Пространственные и количественные" ;
    sn:transitive true .

sn:object a sn:Relation ;
    rdfs:label "объект действия"@ru ;
    sn:domainGroup sn:G_Process ;
    sn:inverseLabel "подвергается"@ru ;
    sn:rangeGroup sn:G_Info ;
    sn:relGroup "Падежные (N-арные)" ;
    sn:transitive false .

sn:partOf a sn:Relation ;
    rdfs:label "состоит из"@ru ;
    sn:domainGroup sn:AnyGroup ;
    sn:inverseLabel "входит в"@ru ;
    sn:rangeGroup sn:AnyGroup ;
    sn:relGroup "Часть – целое" ;
    sn:sameGroup true ;
    sn:transitive true .

sn:performs a sn:Relation ;
    rdfs:label "выполняет"@ru ;
    sn:domainGroup sn:G_Role ;
    sn:inverseLabel "выполняется"@ru ;
    sn:rangeGroup sn:G_Process ;
    sn:relGroup "Функциональные" ;
    sn:transitive false .

sn:place a sn:Relation ;
    rdfs:label "место"@ru ;
    sn:domainGroup sn:G_Process ;
    sn:inverseLabel "является местом"@ru ;
    sn:rangeGroup sn:G_Phys ;
    sn:relGroup "Падежные (N-арные)" ;
    sn:transitive false .

sn:precedes a sn:Relation ;
    rdfs:label "предшествует"@ru ;
    sn:domainGroup sn:G_Process ;
    sn:inverseLabel "следует за"@ru ;
    sn:rangeGroup sn:G_Process ;
    sn:relGroup "Временные" ;
    sn:transitive true .

sn:regulates a sn:Relation ;
    rdfs:label "регламентирует"@ru ;
    sn:domainGroup sn:G_Rule ;
    sn:inverseLabel "регламентируется"@ru ;
    sn:rangeGroup sn:G_Process ;
    sn:relGroup "Нормативные" ;
    sn:transitive false .

sn:responsibleFor a sn:Relation ;
    rdfs:label "отвечает за"@ru ;
    sn:domainGroup sn:G_Role ;
    sn:inverseLabel "в ответственности"@ru ;
    sn:rangeGroup sn:G_Goal ;
    sn:relGroup "Функциональные" ;
    sn:transitive false .

sn:restricts a sn:Relation ;
    rdfs:label "ограничивает"@ru ;
    sn:domainGroup sn:G_Rule ;
    sn:inverseLabel "ограничивается"@ru ;
    sn:rangeGroup sn:G_Goal,
        sn:G_Info ;
    sn:relGroup "Нормативные" ;
    sn:transitive false .

sn:result a sn:Relation ;
    rdfs:label "результат"@ru ;
    sn:domainGroup sn:G_Process ;
    sn:inverseLabel "является результатом"@ru ;
    sn:rangeGroup sn:G_Info ;
    sn:relGroup "Падежные (N-арные)" ;
    sn:transitive false .

sn:uses a sn:Relation ;
    rdfs:label "использует"@ru ;
    sn:domainGroup sn:G_Process,
        sn:G_Role,
        sn:G_System ;
    sn:inverseLabel "используется в"@ru ;
    sn:rangeGroup sn:G_Info,
        sn:G_Phys,
        sn:G_System ;
    sn:relGroup "Функциональные" ;
    sn:transitive false .

sn:AnalystWorkstation a sn:Concept ;
    rdfs:label "Рабочая станция аналитика"@ru ;
    sn:definition "Компьютер, с которого аналитик работает с веб-интерфейсом модуля" ;
    sn:group sn:G_Phys ;
    sn:isA sn:ComputeNode .

sn:Application a sn:Concept ;
    rdfs:label "Заявка на кредит"@ru ;
    sn:attr [ sn:attrName "Норматив обработки" ;
            sn:attrValue "720 ч" ] ;
    sn:definition "Бизнес-объект кредитного процесса, вокруг которого строится экземпляр процесса" ;
    sn:group sn:G_Info ;
    sn:isA sn:BusinessObject .

sn:BPIC2017 a sn:Concept ;
    rdfs:label "Журнал BPI Challenge 2017"@ru ;
    sn:attr [ sn:attrName "Число событий" ;
            sn:attrValue "1 202 267" ] ;
    sn:definition "Конкретный журнал кредитного процесса голландского банка, переведённый в OCEL 2.0" ;
    sn:group sn:G_Info ;
    sn:instanceOf sn:OCELLog .

sn:BottleneckAnalysis a sn:Concept ;
    rdfs:label "Анализ узких мест"@ru ;
    sn:aimsAt sn:GoalBottlenecks ;
    sn:definition "Сопоставление времени ожидания по операциям и выделение тех, что задерживают кейсы" ;
    sn:during sn:SLAMonitoring ;
    sn:group sn:G_Process ;
    sn:uses sn:BPIC2017 .

sn:Converter a sn:Concept ;
    rdfs:label "Конвертер XES→OCEL"@ru ;
    sn:automates sn:XesToOcel ;
    sn:definition "Компонент, строящий объекты и связи OCEL 2.0 из плоского журнала" ;
    sn:group sn:G_System ;
    sn:uses sn:OCELStore .

sn:DataDrift a sn:Concept ;
    rdfs:label "Дрейф данных"@ru ;
    sn:affects sn:ModelQuality ;
    sn:causes sn:Retraining ;
    sn:definition "Состояние, при котором распределение признаков заметно отличается от обучающего" ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject .

sn:DataQualityReq a sn:Concept ;
    rdfs:label "Требования к качеству журнала"@ru ;
    sn:attr [ sn:attrName "Значение" ;
            sn:attrValue "пропуски ≤ 5 %, дубликаты ≤ 1 %, префикс ≥ 3 событий" ] ;
    sn:conditionOf sn:FeatureExtraction ;
    sn:definition "Допустимые доли пропусков и дубликатов и минимальная длина префикса для прогноза" ;
    sn:group sn:G_Rule ;
    sn:regulates sn:QualityCheck ;
    sn:restricts sn:EventLog .

sn:DriftThreshold a sn:Concept ;
    rdfs:label "Порог дрейфа признаков"@ru ;
    sn:attr [ sn:attrName "Значение" ;
            sn:attrValue "PSI > 0,2" ] ;
    sn:conditionOf sn:Retraining ;
    sn:definition "Значение индекса стабильности признаков, выше которого модель переобучается" ;
    sn:group sn:G_Rule ;
    sn:restricts sn:DataDrift .

sn:ERPSystem a sn:Concept ;
    rdfs:label "ERP/CRM-система банка"@ru ;
    sn:creates sn:Application,
        sn:Event ;
    sn:definition "Внешняя учётная система, в которой фиксируются события кредитного процесса" ;
    sn:group sn:G_System .

sn:FeatureModule a sn:Concept ;
    rdfs:label "Модуль извлечения признаков"@ru ;
    sn:automates sn:FeatureExtraction,
        sn:GraphBuilding ;
    sn:definition "Строит граф событие–объект и рассчитывает признаки префиксов" ;
    sn:group sn:G_System .

sn:GNNModule a sn:Concept ;
    rdfs:label "GNN-модуль"@ru ;
    sn:automates sn:GNNTraining,
        sn:KPIForecasting ;
    sn:definition "Обучение и инференс графовых нейросетей" ;
    sn:group sn:G_System ;
    sn:locatedIn sn:GPUServer ;
    sn:uses sn:HeteroGNN,
        sn:NetworkStorage .

sn:GNNTraining a sn:Concept ;
    rdfs:label "Обучение GNN"@ru ;
    sn:attr [ sn:attrName "Вычислительный ресурс" ;
            sn:attrValue "GPU" ] ;
    sn:creates sn:GNNModel ;
    sn:definition "Обучение графовой нейросети на гетерогенном графе событие–объект" ;
    sn:group sn:G_Process ;
    sn:isA sn:ModelTraining ;
    sn:uses sn:EOGraph,
        sn:GPUServer .

sn:HeteroGNN a sn:Concept ;
    rdfs:label "Гетерогенная GNN"@ru ;
    sn:attr [ sn:attrName "Типы вершин" ;
            sn:attrValue "событие, заявка, предложение, ресурс" ] ;
    sn:definition "GNN, различающая типы вершин и рёбер графа (событие, заявка, предложение, ресурс)" ;
    sn:group sn:G_Info ;
    sn:isA sn:GNNModel .

sn:LoadModule a sn:Concept ;
    rdfs:label "Модуль загрузки журналов"@ru ;
    sn:automates sn:LogCollection ;
    sn:definition "Принимает файлы XES/CSV и выполняет их предварительную обработку" ;
    sn:group sn:G_System .

sn:MLModule a sn:Concept ;
    rdfs:label "ML-модуль (XGBoost)"@ru ;
    sn:automates sn:KPIForecasting,
        sn:XGBTraining ;
    sn:definition "Обучение и инференс модели XGBoost" ;
    sn:group sn:G_System ;
    sn:locatedIn sn:AppServer .

sn:ModelSelectionPolicy a sn:Concept ;
    rdfs:label "Политика выбора модели"@ru ;
    sn:definition "Правило выбора прогноза при расхождении XGBoost и GNN более чем на 25 %" ;
    sn:group sn:G_Rule ;
    sn:regulates sn:KPIForecasting .

sn:NetworkStorage a sn:Concept ;
    rdfs:label "Сетевое хранилище"@ru ;
    sn:definition "Общий дисковый ресурс для журналов, весов моделей и трасс вывода" ;
    sn:group sn:G_Phys ;
    sn:locatedIn sn:DataCenter .

sn:NotificationService a sn:Concept ;
    rdfs:label "Сервис уведомлений"@ru ;
    sn:automates sn:SLAEscalation ;
    sn:definition "Внешняя система рассылки сообщений по почте и в мессенджер" ;
    sn:group sn:G_System .

sn:OCELStore a sn:Concept ;
    rdfs:label "Хранилище OCEL (MongoDB)"@ru ;
    sn:definition "Документная СУБД с коллекциями событий, объектов и связей" ;
    sn:group sn:G_System ;
    sn:locatedIn sn:DBServer ;
    sn:uses sn:DBServer .

sn:PraviloOtsecheniyaPrefiksa a sn:Concept ;
    rdfs:label "Правило отсечения префикса"@ru ;
    sn:definition "В признаки входят только события до точки прогноза; события после неё, в том числе раскрывающие исход, исключаются." ;
    sn:group sn:G_Rule ;
    sn:regulates sn:FormirovanieObuchayuscheyVyborki ;
    sn:restricts sn:ObuchayuschayaVyborka .

sn:PredictiveMonitoring a sn:Concept ;
    rdfs:label "Предиктивный мониторинг процесса"@ru ;
    sn:definition "Сквозной процесс: от поступления событий до рекомендации по незавершённым кейсам" ;
    sn:group sn:G_Process ;
    sn:partOf sn:FeatureExtraction,
        sn:KPIForecasting,
        sn:QualityCheck,
        sn:RecommendationMaking,
        sn:SLAMonitoring .

sn:ProcessCase a sn:Concept ;
    rdfs:label "Экземпляр процесса"@ru ;
    sn:definition "Конкретное выполнение процесса для одной заявки — последовательность её событий" ;
    sn:group sn:G_Info ;
    sn:hasProperty sn:CycleTime,
        sn:RemainingTime ;
    sn:isA sn:InformationObject ;
    sn:partOf sn:TracePrefix .

sn:ProcessOwner a sn:Concept ;
    rdfs:label "Владелец процесса"@ru ;
    sn:attr [ sn:attrName "Канал уведомлений" ;
            sn:attrValue "электронная почта и корпоративный мессенджер" ] ;
    sn:definition "Руководитель, который отвечает за KPI процесса и принимает решения по эскалациям" ;
    sn:group sn:G_Role ;
    sn:isA sn:Participant ;
    sn:responsibleFor sn:GoalSLARisk .

sn:XGBModel a sn:Concept ;
    rdfs:label "Модель XGBoost"@ru ;
    sn:definition "Ансамбль деревьев градиентного бустинга, базовая модель сравнения" ;
    sn:group sn:G_Info ;
    sn:isA sn:PredictiveModel .

sn:XGBTraining a sn:Concept ;
    rdfs:label "Обучение XGBoost"@ru ;
    sn:creates sn:XGBModel ;
    sn:definition "Обучение базовой (baseline) модели градиентного бустинга на табличных признаках" ;
    sn:group sn:G_Process ;
    sn:isA sn:ModelTraining ;
    sn:uses sn:FeatureVector .

sn:BusinessObject a sn:Concept ;
    rdfs:label "Бизнес-объект"@ru ;
    sn:affects sn:CycleTime ;
    sn:definition "Сущность, участвующая в событиях: заявка, предложение, ресурс" ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject .

sn:ComputeNode a sn:Concept ;
    rdfs:label "Вычислительный узел"@ru ;
    sn:attr [ sn:attrName "Сеть" ;
            sn:attrValue "корпоративная ЛВС 10 Гбит/с" ] ;
    sn:definition "Оборудование, на котором работают компоненты модуля" ;
    sn:group sn:G_Phys .

sn:DBServer a sn:Concept ;
    rdfs:label "Сервер БД"@ru ;
    sn:definition "Сервер, на котором размещено хранилище OCEL-данных" ;
    sn:group sn:G_Phys ;
    sn:isA sn:Server ;
    sn:locatedIn sn:DataCenter .

sn:DSSModule a sn:Concept ;
    rdfs:label "Модуль поддержки решений"@ru ;
    sn:aimsAt sn:GoalInterpretability ;
    sn:automates sn:RecommendationMaking,
        sn:SLAMonitoring ;
    sn:definition "База знаний с правилами, которая превращает прогнозы в объяснимые рекомендации" ;
    sn:group sn:G_System .

sn:DataSpecialist a sn:Concept ;
    rdfs:label "Специалист по данным"@ru ;
    sn:attr [ sn:attrName "Инструменты" ;
            sn:attrValue "Python, PM4Py, Jupyter" ] ;
    sn:definition "Обобщённая роль сотрудника, работающего с журналами событий и моделями" ;
    sn:group sn:G_Role ;
    sn:isA sn:Participant .

sn:EscalationRegulation a sn:Concept ;
    rdfs:label "Регламент эскалации"@ru ;
    sn:attr [ sn:attrName "Минимальная уверенность" ;
            sn:attrValue "0,7" ] ;
    sn:definition "Кому и при какой уверенности прогноза передаётся кейс с высоким риском" ;
    sn:group sn:G_Rule ;
    sn:regulates sn:SLAEscalation .

sn:Event a sn:Concept ;
    rdfs:label "Событие"@ru ;
    sn:definition "Запись о выполненной операции с временной меткой и атрибутами" ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject .

sn:FormirovanieObuchayuscheyVyborki a sn:Concept ;
    rdfs:label "Формирование обучающей выборки"@ru ;
    sn:creates sn:ObuchayuschayaVyborka ;
    sn:definition "Отсечение трасс завершённых заявок в точке прогноза, расчёт признаков по префиксу и разметка целевой переменной по полной трассе." ;
    sn:group sn:G_Process ;
    sn:precedes sn:ModelTraining ;
    sn:uses sn:TracePrefix .

sn:GNNModel a sn:Concept ;
    rdfs:label "Графовая нейросеть (GNN)"@ru ;
    sn:attr [ sn:attrName "Вход" ;
            sn:attrValue "граф «событие–объект»" ] ;
    sn:definition "Нейросеть, обучающаяся на структуре графа событие–объект" ;
    sn:group sn:G_Info ;
    sn:isA sn:PredictiveModel .

sn:GoalInterpretability a sn:Concept ;
    rdfs:label "Интерпретируемость прогноза"@ru ;
    sn:definition "Возможность показать, из каких фактов и правил получены прогноз и рекомендация" ;
    sn:group sn:G_Goal .

sn:GraphBuilding a sn:Concept ;
    rdfs:label "Построение графа «событие–объект»"@ru ;
    sn:creates sn:EOGraph ;
    sn:definition "Формирование гетерогенного графа, вершины которого — события и объекты разных типов" ;
    sn:group sn:G_Process ;
    sn:precedes sn:FeatureExtraction ;
    sn:uses sn:OCELLog .

sn:KPI a sn:Concept ;
    rdfs:label "Показатель эффективности (KPI)"@ru ;
    sn:attr [ sn:attrName "Единица измерения" ;
            sn:attrValue "часы" ],
        [ sn:attrName "Уровень расчёта" ;
            sn:attrValue "экземпляр процесса" ] ;
    sn:definition "Числовая мера результата процесса, по которой оценивается его эффективность" ;
    sn:group sn:G_Goal .

sn:LogCollection a sn:Concept ;
    rdfs:label "Сбор журнала событий"@ru ;
    sn:creates sn:XESLog ;
    sn:definition "Выгрузка записей о выполнении операций из учётных систем организации" ;
    sn:group sn:G_Process ;
    sn:precedes sn:XesToOcel ;
    sn:uses sn:ERPSystem .

sn:Recommendation a sn:Concept ;
    rdfs:label "Рекомендация"@ru ;
    sn:definition "Сообщение: что сделать, кому и на основании какого правила" ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject .

sn:RemainingTime a sn:Concept ;
    rdfs:label "Остаточное время выполнения"@ru ;
    sn:attr [ sn:attrName "Формула" ;
            sn:attrValue "t_end − t_текущее" ] ;
    sn:definition "Время, которое ещё потребуется незавершённому экземпляру до окончания" ;
    sn:group sn:G_Goal ;
    sn:isA sn:KPI ;
    sn:notGreater sn:CycleTime .

sn:SLANorm a sn:Concept ;
    rdfs:label "Норматив SLA"@ru ;
    sn:attr [ sn:attrName "Значение" ;
            sn:attrValue "720 ч, порог внимания 80 %" ] ;
    sn:definition "Предельное время обработки заявки и доля, после которой кейс считается рискованным" ;
    sn:group sn:G_Rule ;
    sn:regulates sn:SLAMonitoring ;
    sn:restricts sn:CycleTime .

sn:WebUI a sn:Concept ;
    rdfs:label "Веб-интерфейс"@ru ;
    sn:definition "Пользовательский интерфейс модуля на Flask" ;
    sn:group sn:G_System ;
    sn:locatedIn sn:AppServer .

sn:XESLog a sn:Concept ;
    rdfs:label "XES-журнал"@ru ;
    sn:attr [ sn:attrName "Формат" ;
            sn:attrValue "XES (IEEE 1849-2016)" ] ;
    sn:definition "Плоский журнал, в котором каждое событие отнесено к одному идентификатору кейса" ;
    sn:group sn:G_Info ;
    sn:isA sn:EventLog .

sn:AppServer a sn:Concept ;
    rdfs:label "Сервер приложений"@ru ;
    sn:definition "Сервер, на котором выполняются веб-интерфейс, ML-модуль и модуль поддержки решений" ;
    sn:group sn:G_Phys ;
    sn:isA sn:Server ;
    sn:locatedIn sn:DataCenter .

sn:EOGraph a sn:Concept ;
    rdfs:label "Граф «событие–объект»"@ru ;
    sn:definition "Гетерогенный граф связей событий и объектов, вход графовой нейросети" ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject .

sn:EventLog a sn:Concept ;
    rdfs:label "Журнал событий"@ru ;
    sn:attr [ sn:attrName "Обязательные атрибуты события" ;
            sn:attrValue "идентификатор, активность, временная метка" ] ;
    sn:definition "Набор записей о фактическом выполнении операций процесса" ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject .

sn:FeatureVector a sn:Concept ;
    rdfs:label "Вектор признаков"@ru ;
    sn:affects sn:ModelQuality ;
    sn:definition "Упорядоченный набор числовых характеристик префикса" ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject .

sn:Forecast a sn:Concept ;
    rdfs:label "Прогноз KPI"@ru ;
    sn:causes sn:SLAEscalation ;
    sn:definition "Вычисленное моделью остаточное время кейса и уверенность в нём" ;
    sn:group sn:G_Info ;
    sn:hasProperty sn:RemainingTime ;
    sn:isA sn:InformationObject .

sn:GPUServer a sn:Concept ;
    rdfs:label "GPU-сервер"@ru ;
    sn:attr [ sn:attrName "Ускорители" ;
            sn:attrValue "2 × NVIDIA A100 40 ГБ" ] ;
    sn:definition "Сервер с графическими ускорителями для обучения графовых нейросетей" ;
    sn:group sn:G_Phys ;
    sn:isA sn:Server ;
    sn:locatedIn sn:DataCenter .

sn:GoalBottlenecks a sn:Concept ;
    rdfs:label "Выявление узких мест"@ru ;
    sn:definition "Поиск операций и переходов, которые дают наибольший вклад в задержку экземпляров процесса" ;
    sn:group sn:G_Goal .

sn:ObuchayuschayaVyborka a sn:Concept ;
    rdfs:label "Обучающая выборка"@ru ;
    sn:affects sn:ModelQuality ;
    sn:definition "Набор префиксов завершённых заявок, обрезанных до момента прогноза (для прогноза исхода — до создания первого оффера O_Created), и известных для них значений целевой переменной. Признаки считаются только по событиям префикса, чтобы исключить утечку данных." ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject ;
    sn:partOf sn:FeatureVector .

sn:PredictiveModel a sn:Concept ;
    rdfs:label "Прогнозная модель"@ru ;
    sn:attr [ sn:attrName "Вход" ;
            sn:attrValue "вектор признаков префикса" ],
        [ sn:attrName "Метрики качества" ;
            sn:attrValue "MAE, RMSE, R²" ] ;
    sn:definition "Обученная модель, оценивающая KPI незавершённого кейса" ;
    sn:group sn:G_Info ;
    sn:hasProperty sn:ModelQuality ;
    sn:isA sn:InformationObject .

sn:SLAEscalation a sn:Concept ;
    rdfs:label "Эскалация риска SLA"@ru ;
    sn:agent sn:ProcessOwner ;
    sn:aimsAt sn:GoalSLARisk ;
    sn:basis sn:EscalationRegulation ;
    sn:causes sn:RecommendationMaking ;
    sn:definition "Событие передачи владельцу процесса кейса с высоким риском нарушения норматива" ;
    sn:group sn:G_Process ;
    sn:instrument sn:DSSModule ;
    sn:object sn:ProcessCase ;
    sn:place sn:AppServer ;
    sn:result sn:Recommendation .

sn:Server a sn:Concept ;
    rdfs:label "Сервер"@ru ;
    sn:attr [ sn:attrName "Режим работы" ;
            sn:attrValue "24/7" ] ;
    sn:definition "Вычислительный узел, работающий круглосуточно в серверной" ;
    sn:group sn:G_Phys ;
    sn:isA sn:ComputeNode .

sn:XesToOcel a sn:Concept ;
    rdfs:label "Конвертация XES в OCEL"@ru ;
    sn:creates sn:OCELLog ;
    sn:definition "Перевод плоского журнала в объектно-центрированный с явными связями событие–объект" ;
    sn:group sn:G_Process ;
    sn:precedes sn:QualityCheck ;
    sn:uses sn:XESLog .

sn:CycleTime a sn:Concept ;
    rdfs:label "Время цикла"@ru ;
    sn:attr [ sn:attrName "Формула" ;
            sn:attrValue "t_end − t_start" ] ;
    sn:definition "Длительность экземпляра процесса от первого до последнего события" ;
    sn:group sn:G_Goal ;
    sn:isA sn:KPI ;
    sn:notGreater sn:SLANorm .

sn:FeatureExtraction a sn:Concept ;
    rdfs:label "Извлечение признаков"@ru ;
    sn:creates sn:FeatureVector ;
    sn:definition "Расчёт временных, статистических и графовых признаков префикса кейса" ;
    sn:group sn:G_Process ;
    sn:precedes sn:FormirovanieObuchayuscheyVyborki,
        sn:ModelTraining ;
    sn:uses sn:EOGraph,
        sn:TracePrefix .

sn:GoalSLARisk a sn:Concept ;
    rdfs:label "Снижение риска нарушения SLA"@ru ;
    sn:definition "Своевременное обнаружение кейсов, которые с высокой вероятностью не уложатся в норматив" ;
    sn:group sn:G_Goal .

sn:OCELLog a sn:Concept ;
    rdfs:label "OCEL-журнал"@ru ;
    sn:attr [ sn:attrName "Формат" ;
            sn:attrValue "OCEL 2.0 (JSON, XML, SQLite)" ],
        [ sn:attrName "Типы связей" ;
            sn:attrValue "событие–объект (E2O), объект–объект (O2O)" ] ;
    sn:definition "Журнал, в котором событие связано с несколькими объектами разных типов" ;
    sn:group sn:G_Info ;
    sn:isA sn:EventLog ;
    sn:partOf sn:BusinessObject,
        sn:Event .

sn:Participant a sn:Concept ;
    rdfs:label "Участник процесса"@ru ;
    sn:attr [ sn:attrName "Доступ к модулю" ;
            sn:attrValue "через веб-интерфейс по учётной записи" ] ;
    sn:definition "Человек или роль, работающие с модулем или зависящие от результата его работы" ;
    sn:group sn:G_Role .

sn:QualityCheck a sn:Concept ;
    rdfs:label "Проверка качества данных"@ru ;
    sn:definition "Контроль пропусков, дубликатов, порядка временных меток и достаточности префикса" ;
    sn:group sn:G_Process ;
    sn:precedes sn:GraphBuilding ;
    sn:uses sn:OCELLog .

sn:Retraining a sn:Concept ;
    rdfs:label "Переобучение модели"@ru ;
    sn:definition "Повторное обучение модели при обнаружении дрейфа данных" ;
    sn:group sn:G_Process ;
    sn:isA sn:ModelTraining .

sn:TracePrefix a sn:Concept ;
    rdfs:label "Префикс трассы"@ru ;
    sn:definition "Уже выполненная начальная часть трассы незавершённого кейса" ;
    sn:group sn:G_Info ;
    sn:isA sn:InformationObject .

sn:DataCenter a sn:Concept ;
    rdfs:label "Серверная (ЦОД)"@ru ;
    sn:definition "Помещение, где установлены серверы и хранилище" ;
    sn:group sn:G_Phys .

sn:KPIForecasting a sn:Concept ;
    rdfs:label "Прогнозирование KPI"@ru ;
    sn:creates sn:Forecast ;
    sn:definition "Получение оценки остаточного времени кейса по его текущему префиксу" ;
    sn:group sn:G_Process ;
    sn:precedes sn:SLAMonitoring ;
    sn:uses sn:PredictiveModel,
        sn:TracePrefix .

sn:ModelQuality a sn:Concept ;
    rdfs:label "Метрика качества модели"@ru ;
    sn:attr [ sn:attrName "Метрики" ;
            sn:attrValue "MAE, RMSE, R²" ] ;
    sn:definition "Ошибка прогноза модели на отложенной выборке" ;
    sn:group sn:G_Goal .

sn:RecommendationMaking a sn:Concept ;
    rdfs:label "Формирование рекомендации"@ru ;
    sn:aimsAt sn:GoalSLARisk ;
    sn:creates sn:Recommendation ;
    sn:definition "Подготовка предложения: что сделать, кому и на каком основании" ;
    sn:group sn:G_Process ;
    sn:uses sn:Forecast,
        sn:NotificationService .

sn:AnyGroup a sn:Group ;
    rdfs:label "любая группа"@ru ;
    sn:order 99 .

sn:ModelTraining a sn:Concept ;
    rdfs:label "Обучение модели"@ru ;
    sn:attr [ sn:attrName "Разбиение выборки" ;
            sn:attrValue "по времени, 80/20" ] ;
    sn:definition "Настройка параметров модели прогнозирования по обучающей выборке" ;
    sn:group sn:G_Process ;
    sn:precedes sn:KPIForecasting ;
    sn:uses sn:ObuchayuschayaVyborka .

sn:SLAMonitoring a sn:Concept ;
    rdfs:label "Мониторинг SLA"@ru ;
    sn:aimsAt sn:GoalSLARisk ;
    sn:definition "Регулярное сравнение прогнозного времени цикла кейсов с нормативом" ;
    sn:group sn:G_Process ;
    sn:precedes sn:RecommendationMaking ;
    sn:uses sn:Forecast .

sn:G_Role a sn:Group ;
    rdfs:label "Роли и участники"@ru ;
    sn:color "#e07a5f" ;
    sn:order 1 .

sn:InformationObject a sn:Concept ;
    rdfs:label "Информационный объект"@ru ;
    sn:attr [ sn:attrName "Хранится в" ;
            sn:attrValue "хранилище OCEL / сетевом хранилище" ],
        [ sn:attrName "Срок хранения" ;
            sn:attrValue "3 года" ] ;
    sn:definition "Данные, документы и сообщения, которые создаются и используются в процессах модуля" ;
    sn:group sn:G_Info .

sn:G_Rule a sn:Group ;
    rdfs:label "Бизнес-правила и ограничения"@ru ;
    sn:color "#e5989b" ;
    sn:order 6 .

sn:G_Goal a sn:Group ;
    rdfs:label "Цели и показатели"@ru ;
    sn:color "#f2cc8f" ;
    sn:order 2 .

sn:G_Phys a sn:Group ;
    rdfs:label "Физические объекты"@ru ;
    sn:color "#b8b8d1" ;
    sn:order 5 .

sn:G_System a sn:Group ;
    rdfs:label "Система, модули, внешние системы"@ru ;
    sn:color "#cdb4db" ;
    sn:order 7 .

sn:G_Info a sn:Group ;
    rdfs:label "Информационные объекты"@ru ;
    sn:color "#8ecae6" ;
    sn:order 4 .

sn:G_Process a sn:Group ;
    rdfs:label "Бизнес-процессы и операции"@ru ;
    sn:color "#81b29a" ;
    sn:order 3 .

